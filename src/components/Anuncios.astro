---
// Anuncios y eventos que el dueño publica desde el panel (/admin).
// La sección viene escondida y se muestra sola cuando hay anuncios (src/scripts/anuncios-vivo.ts).
---

<section id="anuncios" class="relative py-24" hidden>
  <div class="mx-auto max-w-6xl px-4">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-[0.3em] text-oro">ANUNCIOS Y EVENTOS</p>
      <h2 class="mt-3 font-titulo text-4xl font-bold sm:text-5xl">Lo que <span class="oro">viene</span></h2>
      <p class="mt-4 text-lg text-suave">Eventos, noticias y avisos de la emisora.</p>
    </div>
    <div data-lista-anuncios class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"></div>
  </div>
</section>
