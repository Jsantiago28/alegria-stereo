---
import Icono from "./Icono.astro";

const campo =
  "mt-1.5 w-full rounded-xl border border-white/10 bg-noche/60 px-4 py-3 text-white placeholder:text-suave/60 outline-none transition focus:border-oro focus:ring-2 focus:ring-oro/30";
---

<section id="pide" class="relative bg-noche-2/60 py-24">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 lg:grid-cols-2">
    <div class="aparece">
      <p class="text-sm font-semibold tracking-[0.3em] text-oro">PIDE TU CANCIÓN</p>
      <h2 class="mt-3 font-titulo text-4xl font-bold sm:text-5xl">Tu canción, <span class="oro">tu saludo</span></h2>
      <p class="mt-5 text-lg text-suave">
        Pide la canción que quieres oír, dedícasela a alguien especial o manda un saludo al aire. Llenas el formulario y te
        abrimos WhatsApp con el mensaje listo para enviar.
      </p>

      <div class="mt-8 space-y-4">
        {
          [
            ["musica", "Elige tu canción", "La que te recuerda a alguien o la que te pone a bailar."],
            ["corazon", "Dedícala", "A tu pareja, tu mamá, tus amigos… o a ti mismo."],
            ["radio", "Escúchala al aire", "Mantén la radio sonando para oír tu saludo."],
          ].map(([icono, titulo, texto]) => (
            <div class="flex gap-4">
              <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-oro/15 text-oro">
                <Icono nombre={icono} />
              </span>
              <div>
                <p class="font-semibold text-white">{titulo}</p>
                <p class="text-sm text-suave">{texto}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <form id="form-pedido" class="aparece vidrio borde-oro space-y-4 rounded-3xl p-6 sm:p-8" novalidate>
      <div>
        <label for="cancion" class="text-sm font-semibold">Canción y artista</label>
        <input id="cancion" name="cancion" required maxlength="120" class={campo} placeholder="Ej.: Ojalá que llueva café – Juan Luis Guerra" />
      </div>
      <div>
        <label for="para" class="text-sm font-semibold">Dedicada a <span class="font-normal text-suave">(opcional)</span></label>
        <input id="para" name="para" maxlength="80" class={campo} placeholder="¿Para quién es?" />
      </div>
      <div>
        <label for="saludo" class="text-sm font-semibold">Saludo <span class="font-normal text-suave">(opcional)</span></label>
        <textarea id="saludo" name="saludo" rows="3" maxlength="300" class={campo} placeholder="Lo que quieres que digan al aire"></textarea>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="nombre" class="text-sm font-semibold">Tu nombre</label>
          <input id="nombre" name="nombre" required maxlength="60" autocomplete="name" class={campo} />
        </div>
        <div>
          <label for="desde" class="text-sm font-semibold">Desde dónde <span class="font-normal text-suave">(opcional)</span></label>
          <input id="desde" name="desde" maxlength="60" class={campo} placeholder="Ciudad o país" />
        </div>
      </div>
      <p id="error-pedido" class="hidden rounded-xl bg-red-500/15 px-4 py-2 text-sm text-red-200" role="alert"></p>
      <button type="submit" class="boton-wa w-full text-lg !py-4">
        <Icono nombre="whatsapp" class="size-6" /> Enviar por WhatsApp
      </button>
      <p class="text-center text-xs text-suave">Se abre WhatsApp con tu mensaje, y tu pedido le llega también a la emisora.
        <a href="/privacidad" class="underline underline-offset-2 hover:text-oro">Aviso de privacidad</a></p>
    </form>
  </div>
</section>
