---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import Icono from "./Icono.astro";
import BotonPlay from "./BotonPlay.astro";
import { emisora } from "../data/emisora";

const anio = new Date().getFullYear();
---

<footer class="border-t border-white/5 py-12">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 text-center">
    <Image src={logo} alt={emisora.nombre} width={112} height={112} class="size-28 rounded-full" />
    <p class="font-titulo text-lg font-bold"><span class="oro">{emisora.lema}</span></p>
    <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-suave" aria-label="Pie de página">
      <a href="#nosotros" class="hover:text-white">Nosotros</a>
      <a href="#programacion" class="hover:text-white">Programación</a>
      <a href="#talentos" class="hover:text-white">Talentos</a>
      <a href="#pide" class="hover:text-white">Pide tu canción</a>
      <a href="#contacto" class="hover:text-white">Contacto</a>
    </nav>
    <div class="flex gap-3">
      <a href={emisora.instagram} data-red="instagram" target="_blank" rel="noopener" aria-label="Instagram de la emisora" class="grid size-11 place-items-center rounded-full border border-white/15 hover:border-oro hover:text-oro">
        <Icono nombre="instagram" />
      </a>
      <a href={emisora.tiktok} data-red="tiktok" target="_blank" rel="noopener" aria-label="TikTok de la emisora" class="grid size-11 place-items-center rounded-full border border-white/15 hover:border-oro hover:text-oro">
        <Icono nombre="tiktok" />
      </a>
      <a href="#" hidden data-red="facebook" target="_blank" rel="noopener" aria-label="Facebook de la emisora" class="grid size-11 place-items-center rounded-full border border-white/15 hover:border-oro hover:text-oro">
        <Icono nombre="facebook" />
      </a>
      <a href="#" hidden data-red="youtube" target="_blank" rel="noopener" aria-label="YouTube de la emisora" class="grid size-11 place-items-center rounded-full border border-white/15 hover:border-oro hover:text-oro">
        <Icono nombre="youtube" />
      </a>
      <a href={`https://wa.me/${emisora.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp de la emisora" class="grid size-11 place-items-center rounded-full border border-white/15 hover:border-oro hover:text-oro">
        <Icono nombre="whatsapp" />
      </a>
    </div>
    <div class="text-sm text-suave">
      <p>© {anio} {emisora.nombre} · {emisora.ciudad}</p>
      <p class="mt-1 text-xs text-suave/70">
        Diseño y desarrollo web: <a href="https://jonathansantiago.pages.dev" target="_blank" rel="noopener" class="underline-offset-2 hover:text-oro hover:underline">Jonathan Santiago</a>
      </p>
    </div>
  </div>
</footer>

<!-- Reproductor fijo de abajo -->
<div id="mini" class="fixed inset-x-0 bottom-0 z-50 border-t border-oro/25 bg-noche/90 backdrop-blur-xl" role="region" aria-label="Reproductor de la radio">
  <div class="ecualizador absolute inset-x-0 -top-px flex h-1 items-end gap-0.5 opacity-80" aria-hidden="true">
    {Array.from({ length: 60 }).map(() => <span />)}
  </div>
  <div class="mx-auto flex h-20 max-w-6xl items-center gap-3 px-4">
    <BotonPlay class="boton-oro grid size-12 shrink-0 place-items-center !p-0" icono="size-5" />
    <Image src={logo} alt="" width={48} height={48} class="disco hidden size-12 shrink-0 rounded-full sm:block" />
    <div class="min-w-0 flex-1">
      <p class="en-vivo flex items-center gap-1.5 text-[0.7rem] font-bold tracking-widest text-red-300">EN VIVO</p>
      <p class="truncate text-sm font-semibold text-white" data-cancion>{emisora.nombre}</p>
      <p class="truncate text-xs text-suave" data-artista>{emisora.lema}</p>
    </div>
    <label class="hidden items-center gap-2 text-suave md:flex">
      <Icono nombre="volumen" />
      <span class="sr-only">Volumen</span>
      <input id="volumen" type="range" min="0" max="1" step="0.05" value="1" class="w-24" />
    </label>
    <button type="button" data-compartir class="grid size-11 shrink-0 place-items-center rounded-full border border-white/15 hover:border-oro hover:text-oro" aria-label="Compartir la emisora">
      <Icono nombre="compartir" />
    </button>
    <a href={`https://wa.me/${emisora.whatsapp}`} target="_blank" rel="noopener" class="grid size-11 shrink-0 place-items-center rounded-full bg-[#25d366] text-[#06290f]" aria-label="Escríbenos por WhatsApp">
      <Icono nombre="whatsapp" class="size-6" />
    </a>
  </div>
</div>

<audio id="audio" preload="none"></audio>
<p id="aviso" class="pointer-events-none fixed inset-x-4 bottom-24 z-50 mx-auto hidden max-w-sm rounded-2xl bg-white px-4 py-3 text-center text-sm font-semibold text-noche shadow-2xl" role="status"></p>
