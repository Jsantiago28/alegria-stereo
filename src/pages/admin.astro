---
// Panel del administrador (solo el dueño). Todo funciona en el navegador y habla con Supabase.
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "@fontsource-variable/unbounded";
import "../styles/admin.css";
import { getImage } from "astro:assets";
import logo from "../assets/logo.png";
import { emisora } from "../data/emisora";

const icono = await getImage({ src: logo, width: 192, height: 192, format: "png" });
const logoChico = await getImage({ src: logo, width: 192, height: 192, format: "webp" });

const i = (d: string) =>
  `<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const secciones = [
  { id: "inicio", texto: "Inicio", icono: i('<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>') },
  { id: "pedidos", texto: "Pedidos", icono: i('<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>') },
  { id: "comentarios", texto: "Comentarios", icono: i('<path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8Z"/>') },
  { id: "cantantes", texto: "Cantantes", icono: i('<rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0M12 17v5"/>') },
  { id: "programas", texto: "Programas", icono: i('<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/>') },
  { id: "anuncios", texto: "Anuncios y eventos", icono: i('<path d="M3 11v2a1 1 0 0 0 1 1h2l5 4V6L6 10H4a1 1 0 0 0-1 1z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/>') },
  { id: "anunciantes", texto: "Anunciantes", icono: i('<path d="M11 17l-2 2a2.8 2.8 0 0 1-4-4l4-4M13 7l2-2a2.8 2.8 0 0 1 4 4l-4 4M8 16l8-8"/>') },
];
const datos = {
  id: "datos",
  texto: "Datos de la emisora",
  icono: i('<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>'),
};
const temas = [
  { id: "noche", texto: "Noche", fondo: "#050a24", borde: "#ffc21a" },
  { id: "dia", texto: "Día", fondo: "#f3f5fb", borde: "#a87200" },
  { id: "sol", texto: "Sol", fondo: "#ffffff", borde: "#000000" },
];
---

<!doctype html>
<html lang="es" data-tema="noche">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel · {emisora.nombre}</title>
    <meta name="theme-color" content="#0a1440" />
    <link rel="icon" type="image/png" href={icono.src} />
    <script is:inline>
      try {
        var t = localStorage.getItem("tema-panel");
        if (t === "noche" || t === "dia" || t === "sol") document.documentElement.dataset.tema = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <div id="vista-cargando" class="pantalla-centro"><p class="mut">Cargando el panel…</p></div>

    <!-- Entrar -->
    <div id="vista-entrar" class="pantalla-centro" hidden>
      <form id="form-entrar" class="tarjeta tarjeta-entrar" novalidate>
        <img src={logoChico.src} alt="" width="96" height="96" />
        <h1 class="titulo-fuente">{emisora.nombre}</h1>
        <p>Panel del administrador</p>
        <div>
          <label class="etiqueta" for="correo">Correo</label>
          <input id="correo" name="correo" type="email" class="entrada" autocomplete="username" required />
        </div>
        <div>
          <label class="etiqueta" for="clave">Contraseña</label>
          <input id="clave" name="clave" type="password" class="entrada" autocomplete="current-password" required />
        </div>
        <p id="error-entrar" class="aviso-error" role="alert" hidden></p>
        <p id="aviso-entrar" class="chip-ok" style="padding:12px 14px;border-radius:12px;font-weight:600" role="status" hidden></p>
        <button type="submit" class="boton boton-grande">Entrar</button>
        <button type="button" id="olvide" class="enlace-boton" style="align-self:center">¿Olvidaste tu contraseña?</button>
      </form>
    </div>

    <!-- Nueva contraseña (llega desde el correo de recuperación) -->
    <div id="vista-clave" class="pantalla-centro" hidden>
      <form id="form-clave" class="tarjeta tarjeta-entrar" novalidate>
        <h1 class="titulo-fuente">Nueva contraseña</h1>
        <p>Escribe tu nueva contraseña dos veces.</p>
        <div>
          <label class="etiqueta" for="clave-nueva">Nueva contraseña</label>
          <input id="clave-nueva" type="password" class="entrada" autocomplete="new-password" minlength="8" required />
          <p class="ayuda">Mínimo 8 letras o números.</p>
        </div>
        <div>
          <label class="etiqueta" for="clave-repite">Repítela</label>
          <input id="clave-repite" type="password" class="entrada" autocomplete="new-password" required />
        </div>
        <p id="error-clave" class="aviso-error" role="alert" hidden></p>
        <button type="submit" class="boton boton-grande">Guardar contraseña</button>
      </form>
    </div>

    <!-- Panel -->
    <div id="vista-panel" hidden>
      <header class="cabecera">
        <button id="abrir-menu" class="icono-boton solo-movil" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu">
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
        <div class="marca">
          <img src={logoChico.src} alt="" width="48" height="48" />
          <div style="min-width:0">
            <div class="nombre titulo-fuente">{emisora.nombre}</div>
            <div class="lema">Panel del administrador</div>
          </div>
        </div>
        <div class="acciones">
          <a href="/" target="_blank" rel="noopener" class="boton-linea solo-compu">Ver la página</a>
          <button id="tema-rapido" class="icono-boton" aria-label="Cambiar colores de la pantalla"></button>
          <button id="campana" class="icono-boton" aria-label="Pendientes">
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
            <span class="insignia" data-insignia="total" hidden></span>
          </button>
          <div class="usuario solo-compu"><div class="avatar" aria-hidden="true">RP</div><span>Robinson</span></div>
          <button id="salir" class="boton-suave solo-compu">Salir</button>
        </div>
      </header>

      <div class="cuerpo">
        <nav id="menu" class="menu" aria-label="Menú del panel">
          <div class="rotulo">MENÚ</div>
          {
            secciones.map((s) => (
              <button class="item-menu" data-ir={s.id}>
                <Fragment set:html={s.icono} />
                <span class="texto">{s.texto}</span>
                {(s.id === "pedidos" || s.id === "comentarios") && <span class="insignia" data-insignia={s.id} hidden />}
              </button>
            ))
          }
          <hr />
          <button class="item-menu" data-ir={datos.id}><Fragment set:html={datos.icono} /><span class="texto">{datos.texto}</span></button>
          <hr />
          <div class="temas">
            <div class="t">Colores de la pantalla</div>
            <div class="s">«Sol» se lee mejor afuera.</div>
            <div class="opciones" role="radiogroup" aria-label="Colores de la pantalla">
              {
                temas.map((t) => (
                  <button role="radio" aria-checked="false" data-tema={t.id}>
                    <span class="muestra" style={`background:${t.fondo};border:2px solid ${t.borde}`} />
                    {t.texto}
                  </button>
                ))
              }
            </div>
          </div>
          <a href="/" target="_blank" rel="noopener" class="item-menu solo-movil" style="text-decoration:none;margin-top:10px">Ver la página</a>
          <button id="salir-movil" class="item-menu solo-movil" style="color:var(--txt2)">Salir</button>
        </nav>
        <button id="velo" class="velo" aria-label="Cerrar menú" hidden></button>
        <main id="contenido" class="contenido" tabindex="-1"></main>
      </div>
    </div>

    <dialog id="confirmar" class="confirmar" aria-labelledby="confirmar-titulo">
      <h2 id="confirmar-titulo"></h2>
      <p id="confirmar-texto"></p>
      <div class="botones">
        <button type="button" class="boton-suave" data-respuesta="no">No, cancelar</button>
        <button type="button" class="boton-borrar" data-respuesta="si">Sí, borrar</button>
      </div>
    </dialog>

    <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>

    <script>
      import "../scripts/admin.ts";
    </script>
  </body>
</html>
