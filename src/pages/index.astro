---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Nosotros from "../components/Nosotros.astro";
import Programacion from "../components/Programacion.astro";
import Anuncios from "../components/Anuncios.astro";
import Talentos from "../components/Talentos.astro";
import PideCancion from "../components/PideCancion.astro";
import Contacto from "../components/Contacto.astro";
import Pie from "../components/Pie.astro";
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <Nosotros />
    <Programacion />
    <Anuncios />
    <Talentos />
    <PideCancion />
    <Contacto />
  </main>
  <Pie />
</Layout>

<script>
  import "../scripts/radio.ts";
  import { cargarAnuncios } from "../scripts/anuncios-vivo.ts";
  cargarAnuncios();
</script>
