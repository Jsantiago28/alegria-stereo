---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Nosotros from "../components/Nosotros.astro";
import Programacion from "../components/Programacion.astro";
import Anuncios from "../components/Anuncios.astro";
import Talentos from "../components/Talentos.astro";
import Cantantes from "../components/Cantantes.astro";
import PideCancion from "../components/PideCancion.astro";
import Comentarios from "../components/Comentarios.astro";
import Anunciantes from "../components/Anunciantes.astro";
import Contacto from "../components/Contacto.astro";
import Pie from "../components/Pie.astro";
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <Nosotros />
    <Programacion />
    <Anuncios />
    <Talentos />
    <Cantantes />
    <PideCancion />
    <Comentarios />
    <Anunciantes />
    <Contacto />
  </main>
  <Pie />
</Layout>

<script>
  import "../scripts/radio.ts";
  // Lo que el dueño maneja desde el panel (/admin). Si Supabase no responde, la página sigue igual.
  import { cargarContacto } from "../scripts/contacto-vivo.ts";
  import { cargarAnuncios } from "../scripts/anuncios-vivo.ts";
  import { cargarCantantes } from "../scripts/cantantes-vivo.ts";
  import { cargarAnunciantes } from "../scripts/anunciantes-vivo.ts";
  import { iniciarComentarios } from "../scripts/comentarios-vivo.ts";
  iniciarComentarios();
  cargarContacto();
  cargarAnuncios();
  cargarCantantes();
  cargarAnunciantes();
</script>
